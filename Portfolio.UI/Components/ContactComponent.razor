@using System.Net
@inject HttpClient _httpClient

<div class="contact-block">
  <h3>Contact</h3>
  <p>For freelancing work and collaboration.</p>
  <EditForm OnValidSubmit="@HandleCF" Model="@_contact">
    <DataAnnotationsValidator />
    <fieldset disabled="@_InProcess">
      <label for="Name">Name</label>
      <InputText id="Name" class="form-control" DisplayName="Name" @bind-Value="_contact.name"
        maxlength="100" autocomplete="name" required />
      <label for="Email">Email</label>
      <InputText id="Email" name="Email" class="form-control" type="email" @bind-Value="_contact.email"
        maxlength="254" autocomplete="email" required />
      <label for="message">Message</label>
      <InputTextArea id="message" name="message" class="form-control" rows="5"
        placeholder="How can I be of service?" @bind-Value="_contact.message" maxlength="5000" required />
      <div class="contact-honeypot" aria-hidden="true">
        <label for="contact-website">Leave this field empty</label>
        <InputText id="contact-website" @bind-Value="_contact.honeypot" tabindex="-1" autocomplete="off" />
      </div>
      <button type="submit" class="btn btn-primary btn-lg" id="btnContact" disabled="@_InProcess">
        @(_InProcess ? "Sending..." : "Submit")
      </button>
      <ValidationSummary class="text-danger dv" id="dvValidation" />
    </fieldset>
  </EditForm>
  @if (_InProcess)
  {
    <p role="progressbar" aria-label="Sending inquiry">Sending your inquiry...</p>
  }
  @if (_success is not null)
  {
    <p role="status">@_success</p>
  }
  @if (_error is not null)
  {
    <p role="alert" class="text-danger">@_error</p>
  }
</div>
@code {
  ContactModel _contact = new();
  bool _InProcess = false;
  string? _success;
  string? _error;

  private async Task HandleCF()
  {
    if (_InProcess)
      return;

    _InProcess = true;
    _success = null;
    _error = null;
    try
    {
      using var response = await _httpClient.PostAsJsonAsync("/api/contact", _contact);
      if (response.StatusCode == HttpStatusCode.Accepted)
      {
        _contact = new();
        _success = "Your inquiry was accepted for sending. Inbox delivery is not guaranteed.";
      }
      else
      {
        _error = response.StatusCode switch
        {
          HttpStatusCode.BadRequest => "Please check your name, email, and message, then try again.",
          HttpStatusCode.GatewayTimeout => "Sending timed out. Delivery is uncertain; please wait before retrying.",
          _ => "Your inquiry could not be sent. Please try again later."
        };
      }
    }
    catch (HttpRequestException)
    {
      _error = "Unable to connect. Check your connection and try again.";
    }
    catch (OperationCanceledException)
    {
      _error = "Sending timed out. Delivery is uncertain; please wait before retrying.";
    }
    finally
    {
      _InProcess = false;
    }
  }
}